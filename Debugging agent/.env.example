# Required: create an API key in the Z.AI developer/API platform.
# Never commit your real .env file or paste the key into public issues.
ZAI_API_KEY=replace_with_your_zai_api_key

# Optional; defaults to the official Z.AI chat completions endpoint.
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions

# Optional; defaults to glm-4.6. Use a model enabled for your API account.
ZAI_MODEL=glm-4.6

# Local SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"
